      "Bash(powershell -Command \"Invoke-WebRequest -Uri ''https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-29/wasi-sdk-29.0-x86_64-windows.tar.gz'' -OutFile ''$env:TEMP\\\\wasi-sdk.tar.gz''\")",
      "Bash(powershell -Command:*)",
      "Bash(powershell -ExecutionPolicy Bypass -File:*)",
      "Bash(tar:*)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm tsc:*)"
    ]
  }
}
